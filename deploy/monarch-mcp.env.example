# /opt/mcp/monarch/monarch-mcp.env  (install with: sudo install -m 0600 -o root -g root ...)
#
# Remote monarch-mcp settings. This file holds NO Monarch credentials: the server
# only uses the pre-provisioned /state/session.pickle. Any MONARCH_EMAIL,
# MONARCH_PASSWORD, MONARCH_MFA_SECRET, MONARCH_TOKEN, or MONARCH_COOKIES set here is
# ignored (and dropped from the process environment) in HTTP mode.
#
# After editing, recreate the container (a restart does not re-read this file):
#   docker compose up -d --force-recreate monarch-mcp

# Public hostname(s) accepted in the Host header (DNS-rebinding protection).
# Requests for any other host get HTTP 421.
MONARCH_ALLOWED_HOSTS=monarch.ntriplealab.com

# Extra browser Origins to allow (https://<each allowed host> is always allowed;
# requests without an Origin header, like Claude's and ChatGPT's servers, are fine).
# MONARCH_ALLOWED_ORIGINS=

# Read-only until you deliberately enable writes.
MONARCH_ENABLE_WRITES=false

# Largest batch update_transactions_bulk accepts (1-100). Oversized batches are
# rejected before anything is changed.
MONARCH_MAX_BULK_UPDATES=25

# Request body cap for /mcp, in bytes.
# MONARCH_HTTP_MAX_BODY_BYTES=1048576
